DATABASE_URL=postgresql+psycopg://arip:arip@localhost:5434/arip
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Alternative to ANTHROPIC_API_KEY for chat/classification — proxies many models via one
# OpenAI-compatible API (https://openrouter.ai). Used only if ANTHROPIC_API_KEY is unset.
# Does NOT provide embeddings — OPENAI_API_KEY is still required for real vector search.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=arip
S3_SECRET_KEY=aripsecret
S3_BUCKET=arip-documents

SMTP_HOST=127.0.0.1
SMTP_PORT=1026
